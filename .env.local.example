# Supabase Variables de Entorno
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Configuración de Correo para Saikora
# Las notificaciones llegan a saikorasupport@gmail.com
# Opcional si deseas envío directo vía servidor SMTP de Gmail:
GMAIL_USER=saikorasupport@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion_gmail
